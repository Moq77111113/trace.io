---
import '../styles/global.css';
import { REPO_URL } from '../config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Trace · Tests, traced.',
  description = 'Self-hostable BDD test management. Write Gherkin, run scenarios, witness what your tests actually did. One Node, one Postgres, MIT.',
  ogImage = 'og.png',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? `${Astro.url.origin}${import.meta.env.BASE_URL}`).toString();
const ogImageUrl = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/${ogImage}`, Astro.site ?? Astro.url.origin).toString();
const faviconUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta name="theme-color" content="#fbb95c" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f2233" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="dark light" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Moq77111113" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trace" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Trace · Tests, traced." />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Trace · Tests, traced." />

    <link rel="me" href={REPO_URL} />

    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="mask-icon" href={faviconUrl} color="#fbb95c" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      try {
        const stored = localStorage.getItem('trace.site.theme');
        document.documentElement.setAttribute('data-theme', stored || 'dark');
        document.documentElement.setAttribute('data-accent', 'amber');
      } catch {
        document.documentElement.setAttribute('data-theme', 'dark');
        document.documentElement.setAttribute('data-accent', 'amber');
      }
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Trace',
      description,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux, macOS, Windows (via Docker)',
      url: canonicalUrl,
      sameAs: [REPO_URL],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      license: 'https://opensource.org/licenses/MIT',
    })}></script>
  </head>
  <body class="relative min-h-screen">
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
