---
import ComingBadge from './ComingBadge.astro';
import { REPO_URL, INSTALL_CMD } from '../config';
---

<section id="install" class="relative py-24 sm:py-32 border-t border-border">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <span class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-ink-3">
      <span class="inline-block size-1.5 rounded-full bg-accent"></span>
      Install
    </span>
    <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-ink">
      One Docker compose. Your machine.
    </h2>
    <p class="mt-3 text-ink-2 text-base sm:text-lg leading-relaxed">
      That's the whole installation. MIT, self-hosted, your data on your machine.
    </p>

    <div class="mt-8 rounded-xl border border-dashed border-accent-ring bg-accent-soft/30 overflow-hidden text-left">
      <div class="flex items-center justify-between gap-2 border-b border-accent-ring/40 px-3 py-2 font-mono text-[11px] text-accent-soft-ink">
        <span>one-line install</span>
        <ComingBadge label="ships with v0.1" />
      </div>
      <pre class="px-4 py-3 font-mono text-[13px] text-accent-soft-ink overflow-x-auto">{INSTALL_CMD}</pre>
    </div>

    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a
        href={REPO_URL}
        target="_blank"
        rel="noreferrer noopener"
        class="inline-flex items-center gap-2 rounded-md bg-accent text-accent-fg px-4 py-2.5 text-sm font-medium hover:bg-accent-hover transition-colors shadow-2"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-1.96c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.74.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.55C20.21 21.38 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" />
        </svg>
        View on GitHub
      </a>
      <a
        href="#quickstart"
        class="inline-flex items-center gap-2 rounded-md border border-border bg-surface text-ink px-4 py-2.5 text-sm font-medium hover:border-border-strong transition-colors"
      >
        Read the quickstart
      </a>
    </div>
  </div>
</section>
