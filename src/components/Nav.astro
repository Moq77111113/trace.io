---
import BrandMark from './BrandMark.astro';
import { REPO_URL } from '../config';

const links = [
  { href: '#how',        label: 'How it works' },
  { href: '#features',   label: 'Features' },
  { href: '#not',        label: 'Boundaries' },
  { href: '#quickstart', label: 'Quickstart' },
  { href: '#api',        label: 'API' },
];
---

<header class="sticky top-0 z-40 backdrop-blur-md border-b border-border bg-overlay">
  <nav class="mx-auto flex max-w-6xl items-center gap-6 px-6 py-3.5">
    <a href="#top" class="flex items-center gap-2.5 text-ink hover:text-ink no-underline">
      <span class="grid size-[22px] place-items-center rounded-md bg-accent text-accent-fg shrink-0">
        <BrandMark size={18} />
      </span>
      <span class="font-semibold tracking-tight">Trace</span>
    </a>

    <ul class="hidden md:flex items-center gap-5 text-sm text-ink-2">
      {links.map((l) => (
        <li><a href={l.href} class="hover:text-ink transition-colors">{l.label}</a></li>
      ))}
    </ul>

    <div class="ml-auto flex items-center gap-2">
      <a
        href={REPO_URL}
        target="_blank"
        rel="noreferrer noopener"
        class="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-1.5 text-sm text-ink-2 hover:text-ink hover:border-border-strong transition-colors"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-1.96c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.74.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.55C20.21 21.38 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" />
        </svg>
        GitHub
      </a>
    </div>
  </nav>
</header>
