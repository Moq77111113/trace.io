---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
---

<!doctype html>
<html lang="en" data-theme="dark" data-accent="amber">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>OG card · Trace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      html, body { margin: 0; padding: 0; }
      body { background: var(--bg); }
    </style>
  </head>
  <body class="font-sans">
    <div
      class="relative overflow-hidden flex flex-col justify-between text-ink"
      style="width:1200px; height:630px;"
    >
      <div
        class="absolute inset-0 pointer-events-none"
        style="background:
          radial-gradient(900px 480px at 88% -10%, var(--accent-soft), transparent 60%),
          radial-gradient(700px 360px at -5% 110%, var(--accent-soft), transparent 60%);"
      ></div>

      <div class="relative z-10 flex items-center justify-between px-20 pt-16">
        <div class="flex items-center gap-4">
          <span class="grid place-items-center rounded-xl bg-accent text-accent-fg" style="width:64px;height:64px;">
            <BrandMark size={44} />
          </span>
          <span class="text-3xl font-semibold tracking-tight">Trace</span>
        </div>
        <span class="font-mono text-base uppercase tracking-[0.18em] text-ink-mute">v0.1.0-mvp · MIT</span>
      </div>

      <div class="relative z-10 px-20">
        <h1 class="font-semibold tracking-tight" style="font-size:128px; line-height:0.95;">
          Tests, <span class="text-accent" style="text-shadow:0 0 80px var(--accent-ring)">traced.</span>
        </h1>
        <p class="mt-6 text-ink-2 max-w-[820px]" style="font-size:28px; line-height:1.4;">
          Self-hostable BDD test management. Write Gherkin, run scenarios, witness what your tests actually did.
        </p>
      </div>

      <div class="relative z-10 flex items-center justify-between px-20 pb-16">
        <div class="flex items-center gap-8 font-mono text-xl text-ink-3">
          <span class="inline-flex items-center gap-2">
            <span class="inline-block rounded-full bg-pass" style="width:10px;height:10px;"></span>
            pass
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="inline-block rounded-full bg-fail" style="width:10px;height:10px;"></span>
            fail
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="inline-block rounded-full bg-skip" style="width:10px;height:10px;"></span>
            skip
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="inline-block rounded-full bg-flake" style="width:10px;height:10px;"></span>
            flake
          </span>
        </div>
        <span class="font-mono text-lg text-ink-mute">moq77111113.github.io/trace.io</span>
      </div>
    </div>
  </body>
</html>
